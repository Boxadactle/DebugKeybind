{
  "schemaVersion": 1,
  "id": "debugkeybind",
  "version": "${version}",

  "name": "DebugKeybind",
  "description": "A basic mod that adds keybinds for the F3 menu",
  "authors": [ "Boxadactle" ],
  "contact": {},

  "license": "MIT",
  "icon": "icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.boxadactle.debugkeybind.fabric.DebugKeybindFabric"
    ],
    "modmenu": [
      "dev.boxadactle.debugkeybind.fabric.ModMenuImpl"
    ]
  },
  "mixins": [
    "debugkeybind.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": "1.16.*",
    "boxlib": "4.*"
  },
  "recommends": {
    "modmenu": "*"
  }
}
